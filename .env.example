# Comfy API key from https://platform.comfy.org/profile/api-keys
# The app uses this single key as Authorization: Bearer and extra_data.api_key_comfy_org.
# Never commit the real key.
COMFY_API_KEY=your-api-key-here

# Comfy endpoint. Default is the public Cloud API.
# For a Comfy Build serverless deployment, set this to the printed endpointUrl:
# COMFY_BASE_URL=https://dep-xxxx.run.comfy.app
COMFY_BASE_URL=https://cloud.comfy.org
