{
  "_meta": {
    "title": "Open Product Swap — LTX-2.3 IC-LoRA (core video model)",
    "description": "SAM3 masks the held product. FLUX 3 edits a product keyframe from SKU photos. LTX-2.3 distilled + in-outpainting IC-LoRA is the core video model: green-screen the masked product, guide with the original clip and the edited keyframe, sample 8 steps.",
    "pipeline": "ltx"
  },
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input.mp4"
    },
    "_meta": { "title": "Source video" }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": ["1", 0],
      "start_time": 0,
      "duration": 2.5,
      "strict_duration": false
    },
    "_meta": { "title": "Trim clip" }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": ["2", 0]
    },
    "_meta": { "title": "Split frames" }
  },
  "4": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["3", 0],
      "upscale_method": "lanczos",
      "width": 768,
      "height": 512,
      "crop": "center"
    },
    "_meta": { "title": "Resize frames" }
  },
  "5": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": ["4", 0],
      "batch_index": 0,
      "length": 1
    },
    "_meta": { "title": "First frame" }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "sku.png"
    },
    "_meta": { "title": "SKU photo 1" }
  },
  "7": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["6", 0],
      "upscale_method": "lanczos",
      "width": 768,
      "height": 768,
      "crop": "center"
    },
    "_meta": { "title": "SKU resize" }
  },
  "8": {
    "class_type": "Flux3ImageNode",
    "inputs": {
      "prompt": "Replace the product held in image 1 with the product shown in image 2. Keep the person's hands, fingers, pose, clothing, background, camera angle and lighting identical. Seat the new product naturally in the grip with matching perspective, contact shadows and reflections.",
      "images.image_1": ["5", 0],
      "images.image_2": ["7", 0],
      "aspect_ratio": "auto",
      "resolution": "1K",
      "grounding": false,
      "safety_tolerance": 4,
      "seed": 42
    },
    "_meta": { "title": "FLUX 3 product keyframe" }
  },
  "9": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sam3.1_multiplex_fp16.safetensors"
    },
    "_meta": { "title": "SAM 3.1" }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "product in the person's hand, bottle, can, box, cup, phone",
      "clip": ["9", 1]
    },
    "_meta": { "title": "Mask object" }
  },
  "11": {
    "class_type": "SAM3_Detect",
    "inputs": {
      "model": ["9", 0],
      "image": ["4", 0],
      "threshold": 0.45,
      "refine_iterations": 2,
      "individual_masks": false,
      "conditioning": ["10", 0]
    },
    "_meta": { "title": "SAM3 video masks" }
  },
  "12": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": ["11", 0],
      "expand": 16,
      "tapered_corners": true
    },
    "_meta": { "title": "Expand mask" }
  },
  "13": {
    "class_type": "LTXVInpaintPreprocess",
    "inputs": {
      "images": ["4", 0],
      "mask": ["12", 0]
    },
    "_meta": { "title": "Green-screen masked product" }
  },
  "14": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors"
    },
    "_meta": { "title": "LTX-2.3 22B distilled" }
  },
  "15": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["14", 0],
      "lora_name": "ltx-2.3-22b-ic-lora-in-outpainting-0.9.safetensors",
      "strength_model": 1
    },
    "_meta": { "title": "LTX IC-LoRA in/outpainting" }
  },
  "16": {
    "class_type": "GetICLoRAParameters",
    "inputs": {
      "iclora_model": ["15", 0]
    },
    "_meta": { "title": "IC-LoRA parameters" }
  },
  "17": {
    "class_type": "LTXAVTextEncoderLoader",
    "inputs": {
      "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors",
      "device": "default"
    },
    "_meta": { "title": "Gemma 3 text encoder" }
  },
  "18": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["15", 0],
      "clip": ["17", 0],
      "lora_name": "gemma-3-12b-it-abliterated_lora_rank64_bf16.safetensors",
      "strength_model": 0,
      "strength_clip": 1
    },
    "_meta": { "title": "Gemma abliterated LoRA (CLIP only)" }
  },
  "19": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "A person holds the replacement product from the reference keyframe. The green region is the product. Photorealistic, original lighting, hands and motion unchanged, camera locked to the source clip.",
      "clip": ["18", 1]
    },
    "_meta": { "title": "Positive" }
  },
  "20": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, overexposed, underexposed, extra fingers, morphing product, green spill, watermark, subtitles, identity change, jitter, warp",
      "clip": ["18", 1]
    },
    "_meta": { "title": "Negative" }
  },
  "21": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["19", 0],
      "negative": ["20", 0],
      "frame_rate": 24
    },
    "_meta": { "title": "LTX frame-rate conditioning" }
  },
  "22": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 768,
      "height": 512,
      "length": 25,
      "batch_size": 1
    },
    "_meta": { "title": "Empty LTX latent (8n+1 frames)" }
  },
  "23": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": ["14", 2],
      "image": ["8", 0],
      "latent": ["22", 0],
      "strength": 1,
      "bypass": false
    },
    "_meta": { "title": "Condition on FLUX 3 keyframe" }
  },
  "24": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": ["21", 0],
      "negative": ["21", 1],
      "vae": ["14", 2],
      "latent": ["23", 0],
      "image": ["13", 0],
      "frame_idx": 0,
      "strength": 0.9,
      "iclora_parameters": ["16", 0]
    },
    "_meta": { "title": "IC-LoRA guide from green-screen clip" }
  },
  "25": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["15", 0],
      "seed": 42,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler_ancestral",
      "scheduler": "linear_quadratic",
      "positive": ["24", 0],
      "negative": ["24", 1],
      "latent_image": ["24", 2],
      "denoise": 1
    },
    "_meta": { "title": "LTX distilled 8-step" }
  },
  "26": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": ["24", 0],
      "negative": ["24", 1],
      "latent": ["25", 0]
    },
    "_meta": { "title": "Crop IC-LoRA guides" }
  },
  "27": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["26", 2],
      "vae": ["14", 2],
      "tile_size": 768,
      "overlap": 64,
      "temporal_size": 4096,
      "temporal_overlap": 64
    },
    "_meta": { "title": "Tiled VAE decode" }
  },
  "28": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["27", 0],
      "fps": 24,
      "codec": "h264",
      "color_space": "sRGB",
      "bit_depth": "auto"
    },
    "_meta": { "title": "Pack mp4" }
  },
  "29": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["28", 0],
      "filename_prefix": "video/open_product_swap_ltx",
      "format": "auto"
    },
    "_meta": { "title": "Save swapped video" }
  },
  "30": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "open_product_swap_keyframe"
    },
    "_meta": { "title": "Save FLUX 3 keyframe" }
  }
}
